# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave anon é pública por design do Supabase —
# não é um segredo, mas mesmo assim não versione o .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de API do TMDB (themoviedb.org/settings/api, "API Key (v3 auth)").
# Sem o prefixo NEXT_PUBLIC_ de propósito: só é lida em código de servidor
# (rotas Next.js), nunca vai para o bundle do cliente.
TMDB_API_KEY=
