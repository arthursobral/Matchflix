# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave anon é pública por design do Supabase —
# não é um segredo, mas mesmo assim não versione o .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de API do TMDB (themoviedb.org/settings/api, "API Key (v3 auth)").
# Sem o prefixo NEXT_PUBLIC_ de propósito: só é lida em código de servidor
# (rotas Next.js), nunca vai para o bundle do cliente.
TMDB_API_KEY=

# Site Key do Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add site),
# exigida pelo Supabase antes do login anônimo (M8, proteção contra abuso).
# A Secret Key correspondente vai no painel do Supabase, não aqui — ver docs/m8-qualidade.md.
# Sem essa variável, o app funciona normalmente sem captcha (ex.: dev local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
